@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="mt-4">
    @await Html.PartialAsync("_HomePartial")
</div>
<div class="mt-4">
    <a asp-controller="Students" asp-action="Index" class="btn btn-primary">
        Students List
    </a>

    <a asp-controller="Attendance" asp-action="Index" class="btn btn-warning">
        View Attendance
    </a>

    <a asp-controller="Attendance" asp-action="Mark" class="btn btn-success">
        Mark Attendance
    </a>
</div>