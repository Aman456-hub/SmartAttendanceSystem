@model IEnumerable<SmartAttendanceSystem.Models.Attendance>

<h2>Attendance List</h2>

<form method="get">
    <label>Select Date:</label>
    <input type="date" name="date" value="@ViewBag.SelectedDate" />
    <button type="submit" class="btn btn-primary">Filter</button>
    <a asp-action="Index" class="btn btn-secondary">Reset</a>
</form>

<br />

<a asp-action="Mark" class="btn btn-primary">Mark Attendance</a>

<table class="table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Date</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Student?.Name</td>
                <td>@item.Date.ToString("dd-MM-yyyy HH:mm")</td>
                <td>
                    @if (item.IsPresent)
                    {
                        <span style="color:green;">Present</span>
                    }
                    else
                    {
                        <span style="color:red;">Absent</span>
                    }
                </td>
                <td>@item.Date.ToString("dd-MM-yyyy HH:mm")</td>

                <td>
                    @if (item.IsPresent)
                    {
                        <span class="badge bg-success">Present</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Absent</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>